# App
APP_ENV=development
REST_PORT=8080

# PostgreSQL
DB_HOST=localhost
# Host port. Default 5432; jika sudah dipakai stack lain, ganti ke 5433.
# docker-compose memetakan DB_PORT host ke 5432 di container.
DB_PORT=5432
DB_DATABASE=hsi_go_api
DB_USERNAME=hsi
DB_PASSWORD=hsi
DB_SCHEMA=public

# Redis
REDIS_ADDR=localhost:6379

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_COOKIE_NAME=hsi_refresh
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (fase 1: mock menulis OTP ke log)
MAIL_DRIVER=mock

# Payment & storage (belum dipakai di fase 1)
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=replace-with-mock-webhook-secret
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
DOC_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Seed
SEED_ENABLED=false