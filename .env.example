# App
APP_ENV=development
REST_PORT=8080

# PostgreSQL
DB_HOST=localhost
# Host port. Default 5432; jika sudah dipakai stack lain, ganti ke 5433.
# docker-compose memetakan DB_PORT host ke 5432 di container.
DB_PORT=5432
DB_DATABASE=kelana_api
DB_USERNAME=kelana
DB_PASSWORD=kelana
DB_SCHEMA=public

# Redis
REDIS_ADDR=localhost:6379

# Brand
BRAND_NAME=Kelana
BRAND_CODE_PREFIX=KLN
BRAND_MERCHANT_NAME=KELANA

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=kelana
JWT_AUDIENCE=kelana-api
REFRESH_COOKIE_NAME=kelana_refresh
# Produksi: wajib allowlist eksplisit, tanpa "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Batas body global (upload dokumen tetap 3 MB)
MAX_REQUEST_BODY_BYTES=8388608

# Email (fase 1: mock menulis OTP ke log)
MAIL_DRIVER=mock

# Payment (fase 5): mock provider + HMAC webhook
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=replace-with-at-least-16-random-characters
PAYMENT_TTL_SECONDS=86400
# Job expiry pembayaran (fase 6)
PAYMENT_EXPIRY_INTERVAL_SECONDS=30

# Grup WhatsApp (fase 6). URL per trip di trips.wa_group_url lebih diutamakan.
WA_GROUP_URL=https://chat.whatsapp.com/replace-with-real-group

# Document storage (fase 4): local = file terenkripsi AES-256-GCM
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
# Base64 dari tepat 32 byte acak. Generate dengan: openssl rand -base64 32
# Jangan commit nilai asli.
DOCUMENT_ENC_KEY=replace-with-base64-of-32-random-bytes
DOCUMENT_URL_TTL_SECONDS=300

# Seat lock (fase 3)
SEAT_LOCK_TTL_SECONDS=900
# Jaring pengaman jika sweeper mati; harus lebih besar dari SEAT_LOCK_TTL_SECONDS
SEAT_HOLD_SAFETY_TTL_SECONDS=1800
SEAT_SWEEP_INTERVAL_SECONDS=30

# Seed
SEED_ENABLED=false